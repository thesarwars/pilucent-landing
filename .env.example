# Copy to .env.local and fill in. Every NEXT_PUBLIC_ value is visible in the browser.

# The Pilucent API, including /api/v1. Default: the local Docker backend.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# This app's own origin, and where sign-in/out redirects land.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REDIRECT_URL=http://localhost:3000

NEXT_PUBLIC_SITE_NAME=Pilucent
NEXT_PUBLIC_SMARTY_KEY=
NEXT_PUBLIC_STRIPE_PUB_KEY=
