# Copy to .env.local and fill in. Every NEXT_PUBLIC_ value is visible in the browser.

# The Pilucent API, including /api/v1. Default: the local Docker backend.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# This app's own origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The pricing/sign-in site. This app never signs anyone in itself: signed-out
# visits and every logout go to $NEXT_PUBLIC_REDIRECT_URL/pricing, which hands
# tokens back to /auth?tkn=...&rt=... . With no pricing site running locally,
# sign in with `npm run dev:login` and open the URL it prints.
NEXT_PUBLIC_REDIRECT_URL=http://localhost:3000

NEXT_PUBLIC_SITE_NAME=Pilucent
NEXT_PUBLIC_SMARTY_KEY=
NEXT_PUBLIC_STRIPE_PUB_KEY=
